rules_version = '2';

// Reguły bazy Ice Rolls (plan Spark, bez Cloud Functions). Model danych opisuje
// lib/backend/codec.dart.
//
// Admin to konto, którego zweryfikowany e-mail (małymi literami) jest id dokumentu
// w kolekcji admins, np. admins/szefowa@gmail.com z polem role: "owner".
// Ten dokument dodaje się ręcznie w konsoli Firebase, aplikacja nie może go zmienić.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email() { return request.auth.token.get('email', '').lower(); }
    function adminDoc() { return /databases/$(database)/documents/admins/$(email()); }
    function role() {
      return signedIn() && request.auth.token.get('email_verified', false) == true && exists(adminDoc())
        ? get(adminDoc()).data.get('role', '')
        : '';
    }
    function isOwner() { return role() == 'owner'; }
    function isStaff() { return role() == 'owner' || role() == 'staff'; }

    function isText(v) { return v is map && v.pl is string && v.pl.size() <= 2000; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Konto widzi tylko swój dokument roli (żeby aplikacja wiedziała, czy pokazać panel).
    match /admins/{adminEmail} {
      allow read: if signedIn() && email() == adminEmail;
    }

    // Menu, promocje i dane lokalu czyta każdy, także bez logowania (PWA, ekran startowy).
    // Edytuje właściciel. Obsługa może tylko wyłączyć pozycję, np. gdy skończy się składnik.
    match /categories/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /menuItems/{id} {
      allow read: if true;
      allow create, update: if isOwner()
        && request.resource.data.categoryId is string
        && isText(request.resource.data.name)
        && request.resource.data.prices is list;
      allow update: if isStaff() && changed().hasOnly(['active']) && request.resource.data.active is bool;
      allow delete: if isOwner();
    }

    match /promotions/{id} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /shop/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }

    // Dziennik zmian z panelu sklepu: wpis może dodać obsługa, czyta właściciel, nikt nie zmienia.
    match /auditLog/{id} {
      allow read: if isOwner();
      allow create: if isStaff()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // Profil klienta. Klient zmienia tylko imię i zgodę marketingową.
    // Pieczątki zmienia obsługa: dopisuje od 1 do 5 naraz, najwyżej do 10,
    // a nagrodę wydaje tylko z pełnej karty (10 → 0 i licznik nagród +1).
    match /users/{uid} {
      function profileOk() {
        return request.resource.data.displayName is string && request.resource.data.displayName.size() <= 80
          && request.resource.data.marketingConsent is bool;
      }
      function stampsBefore() { return resource.data.get('stamps', 0); }
      function rewardsBefore() { return resource.data.get('rewardsRedeemed', 0); }
      function stampsAfter() { return request.resource.data.stamps; }
      function rewardsAfter() { return request.resource.data.rewardsRedeemed; }
      function addsStamps() {
        return rewardsAfter() == rewardsBefore()
          && stampsAfter() > stampsBefore() && stampsAfter() <= 10 && stampsAfter() - stampsBefore() <= 5;
      }
      function redeemsReward() {
        return stampsBefore() >= 10 && stampsAfter() == 0 && rewardsAfter() == rewardsBefore() + 1;
      }

      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'marketingConsent', 'createdAt'])
        && profileOk()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid
        && changed().hasOnly(['displayName', 'marketingConsent'])
        && profileOk();
      allow update: if isStaff()
        && changed().hasOnly(['stamps', 'rewardsRedeemed', 'lastStampAt'])
        && stampsAfter() is int && rewardsAfter() is int
        && request.resource.data.lastStampAt == request.time
        && (addsStamps() || redeemsReward());
    }

    // Wszystko inne jest zamknięte.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
